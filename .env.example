# NomadNet node with the blog mirror: messages link to <NODE_HASH>:/page/blog/<slug>.mu
NODE_HASH=77777777db2b0274d56ae73fb7518a4a

# Optional, defaults shown
# FEED_URL=https://gluek.info/rss.xml
# DISPLAY_NAME=gluek.info
# POLL_INTERVAL=900
# ANNOUNCE_INTERVAL=21600
# LAST_COUNT=5

# Propagation node for offline subscribers (hex); empty = the nearest one heard on the network
# PROPAGATION_NODE=

# Healthchecks: MONITOR_URL is pinged after every successful feed poll.
# update.sh pings UPDATE_MONITOR_URL on start, success and failure of an update.
# MONITOR_URL=
# UPDATE_MONITOR_URL=
